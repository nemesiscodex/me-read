[Unit]
Description=me-read speech service (Breeze, Qwen, Chatterbox)
After=network-online.target
# The image service and this one cannot share a 16 GB card. Starting either stops the other.
Conflicts=me-read-imager.service

[Service]
WorkingDirectory=%h/me-read-speech
# Where CrispASR finds the hipBLAS and rocBLAS libraries. Override it in a drop-in if yours are elsewhere.
Environment=CRISPASR_LIBRARY_PATH=/opt/rocm/lib
ExecStart=/usr/bin/uv run --frozen python server.py --crispasr-library-path $CRISPASR_LIBRARY_PATH
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
