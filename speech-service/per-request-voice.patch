 private:
+    // The reference clip and transcript this request clones. With no request
+    // voice, the startup voice is used. A request that names a voice which
+    // cannot be used FAILS; it never falls back to the startup voice.
+    bool select_reference(const whisper_params& p, const std::vector<float>*& pcm, std::string& ref_text) {
+        pcm = nullptr;
+        ref_text.clear();
+        if (p.tts_voice.empty()) {
+            if (!ref_pcm_.empty()) {
+                pcm = &ref_pcm_;
+                ref_text = ref_text_;
+            }
+            return true;
+        }
+        const std::string path = voice_file_for(p.tts_voice, p.tts_voice_dir);
+        const RefClip* clip = clip_for(path);
+        if (!clip) {
+            fprintf(stderr,
+                    "crispasr[bt2-tts]: voice '%s' is not a readable WAV (resolved to '%s'). Request refused; "
+                    "no other voice was used.\n",
+                    p.tts_voice.c_str(), path.c_str());
+            return false;
+        }
+        ref_text = p.tts_ref_text;
+        if (ref_text.empty())
+            ref_text = read_text_file(transcript_path_for(path));
+        // The startup voice's own --ref-text still applies to the same bytes.
+        if (ref_text.empty() && path == startup_voice_path_ && clip->key == startup_voice_key_)
+            ref_text = ref_text_;
+        if (ref_text.empty()) {
+            // Never clone against an empty transcript: the clone prompt pairs
+            // the transcript with the audio, so an empty one misaligns them.
+            fprintf(stderr,
+                    "crispasr[bt2-tts]: voice '%s' has no transcript. Send 'ref_text' in the request or put "
+                    "'%s' beside the voice. Request refused rather than cloning against an empty transcript.\n",
+                    p.tts_voice.c_str(), transcript_path_for(path).c_str());
+            return false;
+        }
+        pcm = &clip->pcm;
+        return true;
+    }
+
+    // The decoded clip for the file at `path`, from the cache when its bytes
+    // are unchanged. nullptr when the file is missing or unreadable.
+    const RefClip* clip_for(const std::string& path) {
+        const std::string key = crispasr_consent::file_sha256(path);
+        if (key.empty())
+            return nullptr;
+        for (size_t i = 0; i < ref_cache_.size(); i++) {
+            if (ref_cache_[i].key == key) {
+                std::rotate(ref_cache_.begin(), ref_cache_.begin() + i, ref_cache_.begin() + i + 1);
+                return &ref_cache_.front();
+            }
+        }
+        RefClip clip;
+        clip.key = key;
+        if (!decode_reference(path, clip.pcm))
+            return nullptr;
+        // The file can be overwritten while it is decoded. Keep the audio only
+        // if the bytes still hash to the key it is stored under.
+        if (crispasr_consent::file_sha256(path) != key)
+            return nullptr;
+        ref_cache_.insert(ref_cache_.begin(), std::move(clip));
+        if (ref_cache_.size() > kMaxRefClips)
+            ref_cache_.pop_back();
+        return &ref_cache_.front();
+    }
+
     breeze_tts_2_context* ctx_ = nullptr;
     std::vector<float> ref_pcm_;
     std::string ref_text_;
+    std::string startup_voice_path_;
+    std::string startup_voice_key_;
+    std::vector<RefClip> ref_cache_; // most recently used first
